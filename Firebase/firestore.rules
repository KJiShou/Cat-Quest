rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      function ownsRecord() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validAggregate() {
        let d = request.resource.data;
        return d.keys().hasAll(['playerId', 'playerName', 'bossStage', 'totalTasksCompleted', 'totalFocusMinutes', 'power', 'catLevel', 'updatedAt'])
          && d.keys().hasOnly(['playerId', 'playerName', 'bossStage', 'totalTasksCompleted', 'totalFocusMinutes', 'power', 'catLevel', 'updatedAt'])
          && d.playerId is string && d.playerId == uid
          && d.playerName is string && d.playerName.size() >= 1 && d.playerName.size() <= 20
          && d.playerName.matches('^[^<>\\x00-\\x1F\\x7F-\\x9F]+$')
          && !d.playerName.matches('^[\\s\\p{Z}].*')
          && !d.playerName.matches('.*[\\s\\p{Z}]$')
          && d.bossStage is int && d.bossStage >= 1 && d.bossStage <= 2147483647
          && d.totalTasksCompleted is int && d.totalTasksCompleted >= 0
          && d.totalFocusMinutes is int && d.totalFocusMinutes >= 0
          && d.power is int && d.power >= 0 && d.power <= 2147483647
          && d.catLevel is int && d.catLevel >= 1 && d.catLevel <= 2147483647
          && d.updatedAt is timestamp && d.updatedAt == request.time;
      }
      // Only opted-in aggregate documents live here. Signed-in players may read
      // rankings/counts; private task data never belongs in this collection.
      allow get, list: if request.auth != null;
      allow create, update: if ownsRecord() && validAggregate();
      allow delete: if ownsRecord();
    }
  }
}
